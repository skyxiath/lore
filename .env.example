# Template for .env (which is git-ignored). Copy to .env and fill in real values.
# Required to run the OpenAI front-end probe (tools/) and to auth Modal (modal_app.py).

OPENAI_API_KEY=          # platform.openai.com → API keys (needs a positive credit balance)
MODAL_TOKEN_ID=          # modal.com/settings/tokens → "ak-..."
MODAL_TOKEN_SECRET=      # modal.com/settings/tokens → "as-..."
